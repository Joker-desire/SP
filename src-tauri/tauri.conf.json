{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S·P",
  "version": "0.4.3",
  "identifier": "com.sp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "S·P 选片",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzMEU1RkJDNUFGNUJGMTQKUldRVXYvVmF2RjhPWTViVUVKbGZycVNxY2duaEFxWEgxSFJOTEd0YThaUVQvMUkvYm1ZY0p0UkoK",
      "endpoints": [
        "https://github.com/Joker-desire/SP/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
